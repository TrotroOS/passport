# Supabase (server-only — not exposed to the browser bundle)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser Supabase client (auth session listener) — mirror server values in production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App (required in production — used in emails, invites, and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (Google + Apple) — enable providers in Supabase Dashboard → Authentication → Providers
# Add redirect URL: {NEXT_PUBLIC_APP_URL}/auth/callback
# Google: create OAuth client in Google Cloud Console (Web application)
# Apple: configure Service ID, Key, Team ID, and private key in Apple Developer + Supabase
# Legal pages (optional — defaults shown)
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=Passport Trade Compliance
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=legal@passport.trade
# NEXT_PUBLIC_SUPPORT_EMAIL=trotroosapp@gmail.com
# NEXT_PUBLIC_LEGAL_GOVERNING_LAW=Ghana

# AI Provider (document extraction)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-2024-08-06
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# GOOGLE_AI_API_KEY=your-gemini-key

# Rate limiting (required in production)
# Upstash Redis REST API (recommended)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Or generic Redis REST endpoint:
# REDIS_URL=
# REDIS_TOKEN=

# Platform admin: set first signup user as platform admin (dev only — never in production)
# FIRST_USER_IS_ADMIN=true

# Auto-confirm emails on signup/login (dev only — never in production)
# AUTO_CONFIRM_EMAIL=true

# Inbound document channels (email + WhatsApp)
# INBOUND_EMAIL_ADDRESS=documents@inbound.passport.trade
# INBOUND_EMAIL_SECRET=your-shared-webhook-secret
# INBOUND_ALLOW_UNVERIFIED=true

# Direct Postgres URI for npm run apply-migrations (Dashboard → Database → Connection string)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Optional: credentials for npm run check-migrations RLS login probe
# MIGRATION_CHECK_EMAIL=you@example.com
# MIGRATION_CHECK_PASSWORD=your-password

# Email notifications (SendGrid)
# SENDGRID_API_KEY=your-sendgrid-key
# INBOUND_EMAIL_FROM=Passport <noreply@passport.trade>
# SENDGRID_TEST_TO=you@example.com

# WhatsApp (Twilio)
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# INBOUND_WHATSAPP_NUMBER=+14155238886
# TWILIO_WEBHOOK_URL=https://your-app.com/api/inbound/whatsapp

# Freight tracking (Terminal49 recommended for live container tracking)
# TRACKING_PROVIDER=mock
# TRACKING_PROVIDER=terminal49
# TRACKING_API_KEY=your-terminal49-api-token
# TRACKING_API_URL=https://api.terminal49.com/v2
# TRACKING_DEFAULT_SCAC=MAEU
# Required in production for external tracking webhooks:
# TRACKING_WEBHOOK_SECRET=your-random-secret
# Required in production for scheduled tracking refresh (Vercel cron):
# CRON_SECRET=your-random-secret

# OpenSanctions party screening (optional)
# OPENSANCTIONS_ENABLED=true
# OPENSANCTIONS_API_URL=https://api.opensanctions.org

# Error monitoring (optional, server-only)
# SENTRY_DSN=https://key@o123.ingest.sentry.io/456

# Stripe billing (optional)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
